PORT=3001

# Supabase Postgres connection string.
# Supabase dashboard -> project "newexit" -> Connect -> "Session pooler" -> copy the URI,
# then replace [YOUR-PASSWORD] with your database password
# (forgot it? Project Settings -> Database -> Reset database password).
DATABASE_URL=postgresql://newexit_api.enentpfhlinvvzfqbtjk:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

UPLOAD_DIR=uploads
